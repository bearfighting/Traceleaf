{
  "name": "web-analytics-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "node ./tooling/dev/dev.mjs",
    "dev:next": "node ./tooling/dev/dev.mjs --router next",
    "dev:react": "node ./tooling/dev/dev.mjs --router react",
    "dev:tanstack": "node ./tooling/dev/dev.mjs --router tanstack",
    "check": "bash ./tooling/ci/check.sh",
    "test": "bash ./tooling/ci/test.sh",
    "test:integration": "bash ./tooling/ci/test-integration.sh",
    "test:collector:postgres": "bash ./tooling/db/postgres-test-run.sh collector",
    "test:processor:postgres": "bash ./tooling/db/postgres-test-run.sh processor",
    "test:analytics-api:postgres": "bash ./tooling/db/postgres-test-run.sh analytics-api",
    "e2e": "node ./tests/e2e/runner/cli.mjs",
    "e2e:up": "node ./tests/e2e/runner/cli.mjs up",
    "e2e:down": "node ./tests/e2e/runner/cli.mjs down",
    "e2e:analytics": "node ./tests/e2e/runner/cli.mjs --suite analytics",
    "e2e:configuration": "node ./tests/e2e/runner/cli.mjs --suite configuration",
    "e2e:site-management": "node ./tests/e2e/runner/cli.mjs --suite site-management",
    "e2e:dev-startup": "node ./tests/e2e/runner/cli.mjs --suite dev-startup",
    "e2e:site-onboarding": "node ./tests/e2e/runner/cli.mjs --suite site-onboarding",
    "e2e:dashboard": "node ./tests/e2e/runner/cli.mjs --suite dashboard",
    "e2e:router-adapters": "node ./tests/e2e/runner/cli.mjs --suite router-adapters",
    "e2e:router-compose": "node ./tests/e2e/runner/cli.mjs --suite router-compose",
    "playwright:install": "playwright install chromium",
    "build": "bash ./tooling/ci/build.sh",
    "format": "bash ./tooling/ci/format.sh",
    "format:check": "bash ./tooling/ci/format-check.sh",
    "docker:dev": "node ./tooling/dev/docker-dev.mjs",
    "docker:backend": "node ./tooling/dev/dev-compose.mjs backend",
    "docker:processing": "node ./tooling/dev/dev-compose.mjs processing",
    "db:migrate": "bash ./tooling/db/db-migrate.sh",
    "db:purge-configuration-audit": "bash ./tooling/db/purge-configuration-audit.sh",
    "test:migrations": "bash ./tooling/db/postgres-test-run.sh migrations",
    "test:postgres:up": "docker compose -p web-analytics-test-postgres -f compose.test-postgres.yaml up -d --wait postgres",
    "test:postgres:down": "docker compose -p web-analytics-test-postgres -f compose.test-postgres.yaml down",
    "test:postgres:purge": "docker compose -p web-analytics-test-postgres -f compose.test-postgres.yaml down -v",
    "test:postgres:clean-stale": "bash ./tooling/db/postgres-test-run.sh clean-stale",
    "protocol:validate": "node ./tooling/contracts/validate-protocol.mjs && node ./tooling/contracts/validate-contract-layout.mjs && node ./tooling/contracts/validate-configuration-contract.mjs",
    "capabilities:validate": "node ./tooling/contracts/validate-capabilities.mjs",
    "http:validate": "node ./tooling/contracts/validate-http-fixtures.mjs",
    "analytics:contract:validate": "node ./tooling/contracts/validate-analytics-api-contract.mjs",
    "dashboard:validate": "pnpm --filter @web-analytics/dashboard test",
    "build:packages": "pnpm --filter @web-analytics/protocol-ts --filter @web-analytics/observer-core --filter @web-analytics/observer-next --filter @web-analytics/observer-react-router --filter @web-analytics/observer-tanstack-router --filter @web-analytics/analytics-core --filter @web-analytics/analytics-browser --filter @web-analytics/transport --filter @web-analytics/router-adapters --filter @web-analytics/playground-support build",
    "analytics:definitions:validate": "node ./tooling/contracts/validate-analytics-definitions.mjs",
    "test:geo-mmdb": "cargo test -p collector geo::tests",
    "test:geo-mmdb-local": "cargo test -p collector operator_dbip_city_lite_mmdb_smoke -- --ignored --nocapture",
    "format:check:docs": "bash ./tooling/ci/format-docs-check.sh",
    "dev:up": "node ./tooling/dev/dev-compose.mjs full",
    "dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "ulid": "^3.0.2",
    "vitest": "^5.0.1"
  }
}
