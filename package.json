{
  "name": "web-analytics-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:next": "./scripts/dev.sh --router next",
    "dev:react": "./scripts/dev.sh --router react",
    "dev:tanstack": "./scripts/dev.sh --router tanstack",
    "check": "./scripts/check.sh",
    "test": "./scripts/test.sh",
    "test:integration": "./scripts/test-integration.sh",
    "e2e:analytics": "node ./scripts/e2e-analytics.mjs",
    "e2e:configuration": "node ./scripts/e2e-configuration.mjs",
    "e2e:dashboard": "node ./scripts/e2e-dashboard.mjs",
    "e2e:router-adapters": "node ./scripts/e2e-router-adapters.mjs",
    "e2e:router-compose": "node ./scripts/e2e-router-compose.mjs",
    "playwright:install": "playwright install chromium",
    "build": "./scripts/build.sh",
    "format": "./scripts/format.sh",
    "format:check": "./scripts/format-check.sh",
    "docker:dev": "./scripts/docker-dev.sh",
    "docker:backend": "./scripts/docker-backend.sh",
    "docker:processing": "./scripts/docker-processing.sh",
    "db:migrate": "./scripts/db-migrate.sh",
    "db:purge-configuration-audit": "./scripts/purge-configuration-audit.sh",
    "test:migrations": "bash ./scripts/test-migrations.sh",
    "protocol:validate": "node ./scripts/validate-protocol.mjs && node ./scripts/validate-contract-layout.mjs && node ./scripts/validate-configuration-contract.mjs",
    "capabilities:validate": "node ./scripts/validate-capabilities.mjs",
    "http:validate": "node ./scripts/validate-http-fixtures.mjs",
    "analytics:contract:validate": "node ./scripts/validate-analytics-api-contract.mjs",
    "dashboard:validate": "pnpm --filter @web-analytics/dashboard test",
    "build:packages": "pnpm --filter @web-analytics/protocol-ts --filter @web-analytics/observer-core --filter @web-analytics/observer-next --filter @web-analytics/observer-react-router --filter @web-analytics/observer-tanstack-router --filter @web-analytics/analytics-core --filter @web-analytics/analytics-browser --filter @web-analytics/transport --filter @web-analytics/router-adapters --filter @web-analytics/playground-support build",
    "analytics:definitions:validate": "node ./scripts/validate-analytics-definitions.mjs",
    "test:geo-mmdb": "cargo test -p collector geo::tests",
    "test:geo-mmdb-local": "cargo test -p collector operator_dbip_city_lite_mmdb_smoke -- --ignored --nocapture",
    "format:check:docs": "./scripts/format-docs-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "ulid": "^3.0.2",
    "vitest": "^5.0.1"
  }
}
