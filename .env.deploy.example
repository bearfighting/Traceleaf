# Bind LAN-only ports to the Raspberry Pi's stable LAN IPv4 address.
PI_LAN_IP=192.168.1.50
DASHBOARD_PORT=13000

# Use URL-safe characters in this password because it is also embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Generate one unpadded Base64URL token from 32 random bytes. Set the same token in both fields.
CONFIG_ADMIN_TOKENS=["replace-with-generated-base64url-token"]
DASHBOARD_CONFIG_ADMIN_TOKEN=replace-with-generated-base64url-token

DASHBOARD_DEFAULT_ENVIRONMENT=production
PROCESSOR_POLL_INTERVAL_MS=1000

# Leave empty initially. Configure only trusted proxy CIDRs when Collector is later put behind a proxy.
GEOIP_TRUSTED_PROXIES=
