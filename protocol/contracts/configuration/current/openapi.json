{
  "openapi": "3.1.0",
  "info": {
    "title": "Configuration Administration API",
    "version": "1.0.0",
    "description": "Deployment-admin contract. Dashboard calls this API from its server-side BFF; deployments must protect the Dashboard management entry point and this namespace with a trusted reverse proxy. Admin bearer credentials are never returned to browser clients."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "configAdminBearer": []
    }
  ],
  "paths": {
    "/v1/admin/sites": {
      "get": {
        "operationId": "listManagedSites",
        "summary": "List managed Sites",
        "parameters": [
          { "$ref": "#/components/parameters/SitePageLimit" },
          { "$ref": "#/components/parameters/SitePageCursor" }
        ],
        "responses": {
          "200": {
            "description": "Includes active and archived Sites, ordered by site_id ascending; next_cursor is null when the page is complete.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SiteListResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "post": {
        "operationId": "createManagedSite",
        "summary": "Create a Site and its initial ingest configuration atomically",
        "description": "Requires Idempotency-Key with 1-128 visible ASCII characters; missing or malformed values return 422. The key is scoped to this operation and deployment. Normalize display_name with Unicode NFC and trim; canonicalize website_url and allowed_origins using the Site Management persistence contract; omitted optional capabilities are false. Compute SHA-256 over RFC 8785 canonical JSON of that normalized request, excluding the header, generated Site ID, key material and timestamps. The initial policy is enabled with a 600 requests/minute limit and the generated Ingest Key active, so the Site is configured to accept events after runtime application. A matching retry returns 200 metadata only; a reused key with another normalized request returns 409. The initial plaintext Ingest Key appears only in the first 201 response, which must be no-store.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "site-create-request.schema.json" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created. All Site and initial configuration records committed atomically; save the one-time key now.",
            "headers": {
              "ETag": { "$ref": "#/components/headers/VersionETag" },
              "Cache-Control": {
                "description": "Prevents storage of the one-time plaintext key response.",
                "schema": { "type": "string", "const": "no-store" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SiteCreatedResponse" }
              }
            }
          },
          "200": {
            "description": "Idempotent replay of a committed request. The one-time plaintext key is never returned again.",
            "headers": { "ETag": { "$ref": "#/components/headers/VersionETag" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SiteCreateReplayResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/SiteIdempotencyConflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/admin/sites/{site_id}": {
      "parameters": [{ "$ref": "#/components/parameters/SiteId" }],
      "get": {
        "operationId": "getManagedSite",
        "summary": "Read a Site and its derived setup status",
        "responses": {
          "200": {
            "description": "Current Site metadata, lifecycle, derived setup status and missing requirements.",
            "headers": { "ETag": { "$ref": "#/components/headers/VersionETag" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SiteResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "patch": {
        "operationId": "updateManagedSiteMetadata",
        "summary": "Update Site display name or Website URL",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "site-metadata-update.schema.json" } }
          }
        },
        "responses": {
          "200": {
            "description": "Metadata updated and Site version incremented.",
            "headers": { "ETag": { "$ref": "#/components/headers/VersionETag" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SiteResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/SiteVersionConflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" }
        }
      }
    },
    "/v1/admin/sites/{site_id}/archive": {
      "parameters": [
        { "$ref": "#/components/parameters/SiteId" },
        { "$ref": "#/components/parameters/IfMatch" }
      ],
      "post": {
        "operationId": "archiveManagedSite",
        "summary": "Archive a Site without deleting its history or configuration",
        "responses": {
          "200": {
            "description": "Archived; ingestion is blocked and retained policies remain unchanged.",
            "headers": { "ETag": { "$ref": "#/components/headers/VersionETag" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SiteResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/SiteVersionConflict" },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" }
        }
      }
    },
    "/v1/admin/sites/{site_id}/restore": {
      "parameters": [
        { "$ref": "#/components/parameters/SiteId" },
        { "$ref": "#/components/parameters/IfMatch" }
      ],
      "post": {
        "operationId": "restoreManagedSite",
        "summary": "Restore a Site without enabling any environment policy",
        "responses": {
          "200": {
            "description": "Restored; environment policies retain their existing enabled state.",
            "headers": { "ETag": { "$ref": "#/components/headers/VersionETag" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SiteResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/SiteVersionConflict" },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "428": { "$ref": "#/components/responses/PreconditionRequired" }
        }
      }
    },
    "/v1/admin/sites/{site_id}/capabilities": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SiteId"
        }
      ],
      "get": {
        "operationId": "getSiteCapabilities",
        "summary": "Read site-scoped capability state",
        "responses": {
          "200": {
            "description": "Current stored configuration and runtime application state",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityConfigurationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "put": {
        "operationId": "putSiteCapabilities",
        "summary": "Replace site-scoped capability state",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "capability-update.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; runtime application may still be pending",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityConfigurationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        }
      }
    },
    "/v1/admin/sites/{site_id}/environments/{environment}/ingest-policy": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SiteId"
        },
        {
          "$ref": "#/components/parameters/Environment"
        }
      ],
      "get": {
        "operationId": "getEnvironmentIngestPolicy",
        "summary": "Read environment-scoped ingest policy",
        "responses": {
          "200": {
            "description": "Current stored policy and Collector application state",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestPolicyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "put": {
        "operationId": "putEnvironmentIngestPolicy",
        "summary": "Replace environment-scoped ingest policy",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "environment-policy-update.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; Collector application may still be pending",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestPolicyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        }
      },
      "post": {
        "operationId": "createEnvironmentIngestPolicy",
        "summary": "Create an environment policy before its first ingest key exists",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "environment-policy-update.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Policy created at version 1 with no active ingest keys; ingestion remains closed until a key is issued.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestPolicyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        }
      }
    },
    "/v1/admin/sites/{site_id}/environments/{environment}/ingest-keys": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SiteId"
        },
        {
          "$ref": "#/components/parameters/Environment"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "post": {
        "operationId": "createIngestKey",
        "summary": "Create an ingest key; plaintext is returned once",
        "description": "Creates a new high-entropy public ingest key. The response is the only time the plaintext key is returned. Existing keys remain active until explicitly revoked.",
        "responses": {
          "201": {
            "description": "Key created; save the returned plaintext now",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              },
              "Cache-Control": {
                "description": "Prevents storage of the one-time plaintext key response.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedIngestKey"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        }
      }
    },
    "/v1/admin/sites/{site_id}/environments/{environment}/ingest-keys/{key_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SiteId"
        },
        {
          "$ref": "#/components/parameters/Environment"
        },
        {
          "$ref": "#/components/parameters/KeyId"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "delete": {
        "operationId": "revokeIngestKey",
        "summary": "Revoke an ingest key immediately",
        "responses": {
          "200": {
            "description": "Key removed from the active set; Collector application state is returned",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestPolicyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        }
      }
    },
    "/v1/admin/sites/{site_id}/conversion-funnel-definitions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SiteId"
        }
      ],
      "get": {
        "operationId": "getSiteDefinitionSet",
        "summary": "Read the current site Conversion/Funnel definition set",
        "responses": {
          "200": {
            "description": "Current immutable revision and runtime state"
          },
          "404": {
            "description": "No definition set exists"
          }
        }
      },
      "post": {
        "operationId": "createSiteDefinitionSet",
        "summary": "Create the initial site definition revision",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "conversion-funnel-definition-set-update.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created initial revision"
          },
          "409": {
            "description": "Definition set already exists"
          }
        }
      },
      "put": {
        "operationId": "appendSiteDefinitionRevision",
        "summary": "Append an immutable site definition revision",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[1-9][0-9]*\"$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "conversion-funnel-definition-set-update.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New immutable revision"
          },
          "409": {
            "description": "Revision conflict"
          },
          "422": {
            "description": "Definition validation error"
          }
        }
      }
    },
    "/v1/sites/{site_id}/definition-revisions": {
      "security": [],
      "parameters": [
        {
          "$ref": "#/components/parameters/SiteId"
        }
      ],
      "get": {
        "operationId": "listSiteDefinitionRevisions",
        "summary": "List site definition revisions for report selection",
        "responses": {
          "200": {
            "description": "Revision labels and effective times"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "configAdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Deployment-managed secret. Bootstrap from CONFIG_ADMIN_TOKENS with one or two overlapping tokens. Never expose through a browser bundle."
      }
    },
    "parameters": {
      "SiteId": {
        "name": "site_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "Environment": {
        "name": "environment",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "KeyId": {
        "name": "key_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^ik_[A-Za-z0-9_-]{8,64}$"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Current quoted configuration version; mutations with a stale version return 409 without partial changes.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "required": true,
        "description": "Must be * to create a policy only when no environment resource exists.",
        "schema": {
          "const": "*"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Client-generated key scoped to deployment and Site creation; retained for the Site lifetime.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7E]+$"
        }
      },
      "SitePageLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
      },
      "SitePageCursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque cursor from the preceding response; pagination is stable in ascending site_id order.",
        "schema": { "type": "string", "minLength": 1 }
      }
    },
    "headers": {
      "VersionETag": {
        "description": "Quoted current configuration version.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      }
    },
    "schemas": {
      "EffectiveState": {
        "type": "object",
        "properties": {
          "status": {
            "enum": ["pending", "current", "stale"],
            "description": "Overall status precedence is stale > pending > current. Report stale if any affected service is using a last-known snapshot because configuration storage is unavailable. Otherwise report pending until all affected services have applied stored_version; report current when all have applied it."
          },
          "stored_version": {
            "type": "integer",
            "minimum": 1
          },
          "applied_versions": {
            "type": "object",
            "properties": {
              "collector": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "processor": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "analytics_api": {
                "type": ["integer", "null"],
                "minimum": 1
              }
            },
            "required": ["collector", "processor", "analytics_api"],
            "additionalProperties": false
          }
        },
        "required": ["status", "stored_version", "applied_versions"],
        "additionalProperties": false
      },
      "ManagedSite": {
        "type": "object",
        "properties": {
          "site_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": ["string", "null"] },
          "website_url": { "type": ["string", "null"] },
          "lifecycle_status": { "enum": ["active", "archived"] },
          "setup_status": {
            "enum": ["ready", "needs_attention"],
            "description": "ready only when metadata and required Page Views exist, at least one environment policy is enabled, and every enabled environment policy has at least one allowed Origin and active Ingest Key."
          },
          "missing_requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "display_name",
                "website_url",
                "page_views",
                "environment_ingest_configuration"
              ]
            }
          },
          "version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "site_id",
          "display_name",
          "website_url",
          "lifecycle_status",
          "setup_status",
          "missing_requirements",
          "version",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "SiteResponse": {
        "type": "object",
        "properties": { "site": { "$ref": "#/components/schemas/ManagedSite" } },
        "required": ["site"],
        "additionalProperties": false
      },
      "SiteListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedSite" } },
          "next_cursor": { "type": ["string", "null"] }
        },
        "required": ["items", "next_cursor"],
        "additionalProperties": false
      },
      "SiteCreatedResponse": {
        "type": "object",
        "properties": {
          "site": { "$ref": "#/components/schemas/CreatedManagedSite" },
          "initial_environment": { "type": "string", "minLength": 1, "maxLength": 64 },
          "ingest_key": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
              "key_id": { "type": "string", "pattern": "^ik_[A-Za-z0-9_-]{8,64}$" }
            },
            "required": ["key", "key_id"],
            "additionalProperties": false
          }
        },
        "required": ["site", "initial_environment", "ingest_key"],
        "additionalProperties": false
      },
      "CreatedManagedSite": {
        "allOf": [
          { "$ref": "#/components/schemas/ManagedSite" },
          {
            "type": "object",
            "properties": {
              "site_id": { "type": "string", "pattern": "^site_[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
            },
            "required": ["site_id"]
          }
        ]
      },
      "SiteCreateReplayResponse": {
        "type": "object",
        "properties": { "site": { "$ref": "#/components/schemas/ManagedSite" } },
        "required": ["site"],
        "additionalProperties": false
      },
      "CapabilityConfigurationResponse": {
        "type": "object",
        "properties": {
          "configuration": {
            "$ref": "capabilities.schema.json"
          },
          "effective_state": {
            "$ref": "#/components/schemas/EffectiveState"
          }
        },
        "required": ["configuration", "effective_state"],
        "additionalProperties": false
      },
      "KeyMetadata": {
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["key_id", "created_at"],
        "additionalProperties": false
      },
      "CreatedIngestKey": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "metadata": {
            "$ref": "#/components/schemas/KeyMetadata"
          },
          "effective_state": {
            "$ref": "#/components/schemas/EffectiveState"
          }
        },
        "required": ["key", "metadata", "effective_state"],
        "additionalProperties": false
      },
      "IngestPolicyResponse": {
        "type": "object",
        "properties": {
          "policy": {
            "type": "object",
            "properties": {
              "site_id": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "allowed_origins": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keys": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/KeyMetadata"
                }
              },
              "rate_limit_per_minute": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "site_id",
              "environment",
              "version",
              "enabled",
              "allowed_origins",
              "keys",
              "rate_limit_per_minute"
            ],
            "additionalProperties": false
          },
          "effective_state": {
            "$ref": "#/components/schemas/EffectiveState"
          }
        },
        "required": ["policy", "effective_state"],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "unauthorized",
                  "not_found",
                  "configuration_version_conflict",
                  "configuration_validation_failed",
                  "configuration_unavailable",
                  "configuration_precondition_required",
                  "site_idempotency_conflict",
                  "site_version_conflict"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["path", "code", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "UnauthorizedError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "unauthorized"
                  }
                }
              }
            }
          }
        ]
      },
      "NotFoundError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "not_found"
                  }
                }
              }
            }
          }
        ]
      },
      "VersionConflictError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "configuration_version_conflict"
                  }
                }
              }
            }
          }
        ]
      },
      "ValidationErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "configuration_validation_failed"
                  }
                }
              }
            }
          }
        ]
      },
      "UnavailableError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "configuration_unavailable"
                  }
                }
              }
            }
          }
        ]
      },
      "PreconditionRequiredError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "configuration_precondition_required"
                  }
                }
              }
            }
          }
        ]
      },
      "SiteIdempotencyConflictError": {
        "allOf": [
          { "$ref": "#/components/schemas/Error" },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": { "code": { "const": "site_idempotency_conflict" } }
              }
            }
          }
        ]
      },
      "SiteVersionConflictError": {
        "allOf": [
          { "$ref": "#/components/schemas/Error" },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": { "code": { "const": "site_version_conflict" } }
              }
            }
          }
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid configuration administrator credential.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnauthorizedError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Site, environment, or key was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NotFoundError"
            }
          }
        }
      },
      "VersionConflict": {
        "description": "If-Match version is stale. No part of the mutation was applied.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VersionConflictError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Configuration failed schema or semantic validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Configuration persistence is unavailable. No mutation was applied.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnavailableError"
            }
          }
        }
      },
      "PreconditionRequired": {
        "description": "If-Match is missing or is not a quoted positive version.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PreconditionRequiredError"
            }
          }
        }
      },
      "SiteIdempotencyConflict": {
        "description": "Idempotency-Key was previously committed with a different normalized request. No mutation was applied.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SiteIdempotencyConflictError" }
          }
        }
      },
      "SiteVersionConflict": {
        "description": "If-Match Site version is stale. No mutation was applied.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SiteVersionConflictError" }
          }
        }
      }
    }
  }
}
