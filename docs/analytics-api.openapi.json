{
  "openapi": "3.1.0",
  "info": {
    "title": "Web Analytics API",
    "version": "1.0.0",
    "description": "Read API for Page View, Geo country, Phase 6, Custom Event, Conversion and Funnel reports."
  },
  "servers": [
    {
      "url": "http://localhost:4002"
    }
  ],
  "paths": {
    "/v1/sites/{site_id}/reports/{from}/{to}/geo": {
      "get": {
        "operationId": "geoCountryReport",
        "summary": "Country Page View report",
        "parameters": [
          { "$ref": "#/components/parameters/SiteId" },
          { "$ref": "#/components/parameters/FromPath" },
          { "$ref": "#/components/parameters/ToPath" }
        ],
        "responses": {
          "200": {
            "description": "Page Views grouped by ISO alpha-2 country code, including unknown",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeoCountryReportResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidQuery" },
          "500": { "$ref": "#/components/responses/AnalyticsApiError" }
        }
      }
    },

    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Analytics API and database are available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Analytics API dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sites/{site_id}/overview": {
      "get": {
        "operationId": "getOverview",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          }
        ],
        "responses": {
          "200": {
            "description": "All-time page view total for the site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/overview": {
      "get": {
        "operationId": "getRangeOverview",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Page view total for the inclusive UTC date range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RangeOverviewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/timeline": {
      "get": {
        "operationId": "getTimeline",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily page view totals ordered by day ascending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/pages": {
      "get": {
        "operationId": "getPages",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Page view totals by path, ordered by count descending and path ascending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagesResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/visitors": {
      "get": {
        "operationId": "getVisitors",
        "x-phase": 6,
        "x-lifecycle": "enabled-behind-feature-flag",
        "description": "Visitor and session metrics by UTC day, ordered by day ascending. Requires the site analytics feature flag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Visitor and session metrics by UTC day.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitorSessionReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "404": {
            "$ref": "#/components/responses/AnalyticsNotEnabled"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/sessions": {
      "get": {
        "operationId": "getSessions",
        "x-phase": 6,
        "x-lifecycle": "enabled-behind-feature-flag",
        "description": "Session and visitor metrics by UTC day, ordered by day ascending. Requires the site analytics feature flag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Session and visitor metrics by UTC day.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitorSessionReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "404": {
            "$ref": "#/components/responses/AnalyticsNotEnabled"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/dimensions/{dimension}": {
      "get": {
        "operationId": "getDimensionReport",
        "x-phase": 6,
        "x-lifecycle": "enabled-behind-feature-flag",
        "description": "Dimension metrics for the inclusive UTC date range, ordered by page_views descending and value ascending. Requires the site analytics feature flag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          },
          {
            "$ref": "#/components/parameters/Dimension"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Dimension metrics for the inclusive UTC date range, ordered by page_views descending and value ascending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DimensionReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "404": {
            "$ref": "#/components/responses/AnalyticsNotEnabled"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/events": {
      "get": {
        "operationId": "getEventsReport",
        "x-phase": 7,
        "description": "Custom Event counts by exact event name and UTC event date; properties are never returned.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/EventName"
          }
        ],
        "responses": {
          "200": {
            "description": "Site-scoped Custom Event count report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/web-vitals": {
      "get": {
        "summary": "Get Web Vitals report",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^/"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Web Vitals grouped by route and metric",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "site_id",
                    "from",
                    "to",
                    "total",
                    "items",
                    "data_as_of",
                    "freshness_status",
                    "aggregation_version"
                  ],
                  "properties": {
                    "site_id": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string",
                      "format": "date"
                    },
                    "to": {
                      "type": "string",
                      "format": "date"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "metric",
                          "count",
                          "p75",
                          "good_count",
                          "needs_improvement_count",
                          "poor_count",
                          "status"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "metric": {
                            "enum": ["LCP", "INP", "CLS", "FCP", "TTFB"]
                          },
                          "count": {
                            "type": "integer"
                          },
                          "p75": {
                            "type": ["number", "null"]
                          },
                          "good_count": {
                            "type": "integer"
                          },
                          "needs_improvement_count": {
                            "type": "integer"
                          },
                          "poor_count": {
                            "type": "integer"
                          },
                          "status": {
                            "enum": ["available", "insufficient_data"]
                          }
                        }
                      }
                    },
                    "data_as_of": {
                      "type": ["string", "null"],
                      "format": "date-time"
                    },
                    "freshness_status": {
                      "enum": ["current", "stale", "rebuilding", "failed"]
                    },
                    "aggregation_version": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total samples matching the date and path filters before applying limit."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        },
        "operationId": "getWebVitalsReport",
        "description": "Document-load Web Vitals grouped by Page View path and metric; report date uses the Page View UTC date. p75 uses percentile_disc(0.75) and is null below four samples."
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/conversions": {
      "get": {
        "operationId": "getConversions",
        "description": "Daily matching events and session conversion rates by conversion definition.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/DefinitionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily matching events and session conversion rates by conversion definition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    },
    "/v1/sites/{site_id}/reports/{from}/{to}/funnels": {
      "get": {
        "operationId": "getFunnels",
        "description": "Session counts by funnel step and first-step UTC cohort; each step rate uses the immediately previous step as its denominator.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SiteId"
          },
          {
            "$ref": "#/components/parameters/FromPath"
          },
          {
            "$ref": "#/components/parameters/ToPath"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/DefinitionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Session counts by funnel step and first-step UTC cohort, with adjacent-step conversion rates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "500": {
            "$ref": "#/components/responses/AnalyticsApiError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SiteId": {
        "name": "site_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      },
      "FromPath": {
        "name": "from",
        "in": "path",
        "required": true,
        "description": "Inclusive UTC start date. The report range contains at most 366 UTC calendar days, so to minus from must be at most 365 days.",
        "schema": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "ToPath": {
        "name": "to",
        "in": "path",
        "required": true,
        "description": "Inclusive UTC end date. The report range contains at most 366 UTC calendar days, so to minus from must be at most 365 days.",
        "schema": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Dimension": {
        "name": "dimension",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/DimensionName"
        }
      },
      "EventName": {
        "name": "event_name",
        "in": "query",
        "required": false,
        "description": "Exact, case-sensitive custom event name filter.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "DefinitionId": {
        "name": "definition_id",
        "in": "query",
        "required": false,
        "description": "Exact deployment definition ID filter.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      }
    },
    "responses": {
      "InvalidQuery": {
        "description": "The requested date range or limit is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalidDateRange": {
                "value": {
                  "error": {
                    "code": "invalid_date_range",
                    "message": "from must be before or equal to to"
                  }
                }
              },
              "invalidLimit": {
                "value": {
                  "error": {
                    "code": "invalid_limit",
                    "message": "limit must be between 1 and 100"
                  }
                }
              },
              "dateRangeTooLarge": {
                "value": {
                  "error": {
                    "code": "date_range_too_large",
                    "message": "date range must not exceed 366 days"
                  }
                }
              }
            }
          }
        }
      },
      "AnalyticsApiError": {
        "description": "The Analytics API failed to query its storage.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "analytics_api_error",
                "message": "Analytics API failed to complete the request"
              }
            }
          }
        }
      },
      "AnalyticsNotEnabled": {
        "description": "The site has not enabled Phase 6 analytics reports.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "analytics_not_enabled",
                "message": "analytics report is not enabled"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_date_range",
              "date_range_too_large",
              "invalid_limit",
              "invalid_dimension",
              "analytics_not_enabled",
              "analytics_api_error",
              "invalid_event_name"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OverviewResponse": {
        "type": "object",
        "required": ["site_id", "page_views"],
        "properties": {
          "site_id": {
            "type": "string"
          },
          "page_views": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "RangeOverviewResponse": {
        "type": "object",
        "required": ["site_id", "from", "to", "page_views"],
        "properties": {
          "site_id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "page_views": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "TimelineItem": {
        "type": "object",
        "required": ["day", "page_views"],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "page_views": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "TimelineResponse": {
        "type": "object",
        "required": ["site_id", "from", "to", "items"],
        "properties": {
          "site_id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelineItem"
            }
          }
        },
        "additionalProperties": false
      },
      "PageItem": {
        "type": "object",
        "required": ["path", "page_views"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "page_views": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "PagesResponse": {
        "type": "object",
        "required": ["site_id", "from", "to", "items"],
        "properties": {
          "site_id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageItem"
            }
          }
        },
        "additionalProperties": false
      },
      "DimensionName": {
        "type": "string",
        "enum": [
          "language",
          "timezone",
          "utm_source",
          "utm_medium",
          "utm_campaign",
          "utm_term",
          "utm_content",
          "referrer_host",
          "device",
          "browser",
          "os"
        ]
      },
      "VisitorSessionItem": {
        "type": "object",
        "required": ["day", "page_views", "unique_visitors", "sessions"],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "page_views": {
            "type": "integer",
            "minimum": 0
          },
          "unique_visitors": {
            "type": "integer",
            "minimum": 0
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "VisitorSessionReportResponse": {
        "type": "object",
        "required": [
          "site_id",
          "from",
          "to",
          "page_views",
          "unique_visitors",
          "sessions",
          "items",
          "data_as_of",
          "freshness_status",
          "aggregation_version"
        ],
        "properties": {
          "site_id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "page_views": {
            "type": "integer",
            "minimum": 0
          },
          "unique_visitors": {
            "type": "integer",
            "minimum": 0
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisitorSessionItem"
            }
          },
          "data_as_of": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Common processed_received watermark across all aggregates contributing to the response; null when there is no matching input."
          },
          "freshness_status": {
            "type": "string",
