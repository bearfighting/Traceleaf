{
  "name": "@web-analytics/angular-playground",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "format": "prettier --write src angular.json tsconfig.json tsconfig.app.json package.json",
    "format:check": "prettier --check src angular.json tsconfig.json tsconfig.app.json package.json"
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@traceleaf/browser": "workspace:*",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "typescript": "^5.8.0"
  }
}
