{
  "name": "@web-analytics/tanstack-router-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('Browser coverage is provided by e2e:navigation-api')\"",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@traceleaf/browser": "workspace:*",
    "@web-analytics/analytics-core": "workspace:*",
    "@web-analytics/observer-core": "workspace:*",
    "@web-analytics/playground-support": "workspace:*",
    "@web-analytics/protocol-ts": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
