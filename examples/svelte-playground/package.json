{
  "name": "@web-analytics/svelte-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --plugin prettier-plugin-svelte --write src svelte.config.js vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --plugin prettier-plugin-svelte --check src svelte.config.js vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@traceleaf/browser": "workspace:*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^6.0.0"
  }
}
