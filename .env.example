# Collector configuration path used by the Phase 2 development service.
COLLECTOR_CONFIG=./protocol/contracts/http-ingestion/current/config/collector.example.toml

# PostgreSQL storage used by the Phase 3 Collector.
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics
COLLECTOR_DATABASE_URL=postgres://analytics:analytics@postgres:5432/analytics
PROCESSOR_POLL_INTERVAL_MS=1000
ANALYTICS_DEFINITIONS_FILE=/workspace/config/analytics-definitions.json
# Set one or two 32-byte Base64URL tokens, for example [\"<token>\"]. Leave blank to disable config administration.
CONFIG_ADMIN_TOKENS=
DASHBOARD_SITES=site_example
DASHBOARD_DEFAULT_SITE=site_example
DASHBOARD_DEFAULT_ENVIRONMENT=development
# Set to one deployment-admin token; never use a NEXT_PUBLIC_ variable.
DASHBOARD_CONFIG_ADMIN_TOKEN=

# Playground sends events to the local Collector by default. These sample credentials
# are for local development only and match the development seed configuration.
NEXT_PUBLIC_ANALYTICS_TRANSPORT=fetch
NEXT_PUBLIC_ANALYTICS_ENDPOINT=http://localhost:4001/v1/events
NEXT_PUBLIC_ANALYTICS_INGEST_KEY=public-key-example
NEXT_PUBLIC_ANALYTICS_SITE_ID=site_example
PLAYGROUND_ORIGINS=http://localhost:3000,http://localhost:3101,http://localhost:3102

# Place a supported country lookup MMDB (MaxMind GeoLite2 Country or DB-IP City Lite) here.
GEOIP_DATABASE_PATH=/workspace/data/GeoLite2-Country.mmdb
# Optional comma-separated trusted proxy CIDRs; empty means ignore X-Forwarded-For
GEOIP_TRUSTED_PROXIES=
