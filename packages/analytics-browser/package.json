{
  "name": "@web-analytics/analytics-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts README.md",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts README.md"
  },
  "dependencies": {
    "@web-analytics/analytics-core": "workspace:*",
    "@web-analytics/observer-core": "workspace:*",
    "@web-analytics/protocol-ts": "workspace:*",
    "ulid": "^3.0.2",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
