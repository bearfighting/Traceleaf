{
  "name": "@traceleaf/browser",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "package:acceptance": "node ../../tooling/packages/accept-browser-tarball.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json tsconfig.typecheck.json tsup.config.ts vitest.config.ts README.md",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.typecheck.json tsup.config.ts vitest.config.ts README.md"
  },
  "dependencies": {
    "ulid": "^3.0.2",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
