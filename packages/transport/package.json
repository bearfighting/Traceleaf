{
  "name": "@web-analytics/transport",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts"
  },
  "dependencies": {
    "@web-analytics/analytics-core": "workspace:*",
    "@web-analytics/protocol-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
