{
  "name": "@web-analytics/protocol-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:configuration": "node ../../tooling/contracts/generate-configuration-contract-types.mjs",
    "check:configuration": "node ../../tooling/contracts/generate-configuration-contract-types.mjs --check",
    "format": "prettier --write src package.json tsconfig.json vitest.config.ts",
    "format:check": "prettier --check src package.json tsconfig.json vitest.config.ts"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
